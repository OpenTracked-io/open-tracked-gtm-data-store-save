___SANDBOXED_JS_FOR_SERVER___

const sendHttpRequest = require('sendHttpRequest');
const getEventData = require('getEventData');
const sha256Sync = require('sha256Sync');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const JSON = require('JSON');

function storeKey() {
  const byUser = data.keySource === 'user_id';
  const id = getEventData(byUser ? 'user_id' : 'client_id');
  if (id === undefined || id === null || id === '') {
    return undefined;
  }
  // the id never travels or is stored as it is: only its hash
  return (byUser ? 'uid:' : 'cid:') + sha256Sync(makeString(id), {outputEncoding: 'hex'});
}

function first(keys) {
  for (let i = 0; i < keys.length; i++) {
    const v = getEventData(keys[i]);
    if (v !== undefined && v !== null && v !== '') {
      return makeString(v);
    }
  }
  return undefined;
}

function digits(s) {
  let out = '';
  for (let i = 0; i < s.length; i++) {
    const c = s.charAt(i);
    if (c >= '0' && c <= '9') {
      out += c;
    }
  }
  return out;
}

// personal data is stored hashed (SHA-256), the way Meta, TikTok and Google Ads want it; a value that is already a hash is kept as it is
function hashed(v, phone) {
  if (!v) {
    return undefined;
  }
  let s = v.trim().toLowerCase();
  if (s.match('^[a-f0-9]{64}$') !== null) {
    return s;
  }
  if (phone) {
    s = digits(s);
  }
  return s === '' ? undefined : sha256Sync(s, {outputEncoding: 'hex'});
}

function put(profile, name, value) {
  if (value !== undefined) {
    profile[name] = value;
  }
}

const key = storeKey();
if (!key) {
  data.gtmOnSuccess();
  return;
}

const profile = {};
if (data.saveEmail) {
  put(profile, 'em', hashed(first(['user_data.email_address', 'user_data.email', 'x-fb-ud-em', 'user_data.sha256_email_address']), false));
}
if (data.savePhone) {
  put(profile, 'ph', hashed(first(['user_data.phone_number', 'user_data.phone', 'x-fb-ud-ph', 'user_data.sha256_phone_number']), true));
}
if (data.saveName) {
  put(profile, 'fn', hashed(first(['user_data.address.first_name', 'user_data.first_name', 'x-fb-ud-fn']), false));
  put(profile, 'ln', hashed(first(['user_data.address.last_name', 'user_data.last_name', 'x-fb-ud-ln']), false));
}
if (data.saveExternalId) {
  put(profile, 'external_id', first(['x-fb-ud-external_id', 'user_id']));
}
if (data.saveClickIds) {
  put(profile, 'fbc', first(['x-fb-ck-fbc']));
  put(profile, 'fbp', first(['x-fb-ck-fbp']));
}

if (JSON.stringify(profile) === '{}') {
  data.gtmOnSuccess();
  return;
}

let days = makeInteger(data.ttlDays);
if (!days || days < 1) {
  days = 90;
}

sendHttpRequest(data.apiUrl + '/entries/' + key, {
  method: 'PUT',
  headers: {'Authorization': 'Bearer ' + data.token, 'Content-Type': 'application/json'},
  timeout: 3000
}, JSON.stringify({value: profile, ttl_days: days, merge: true})).then(function(response) {
  if (response.statusCode >= 200 && response.statusCode < 300) {
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
}).catch(function() {
  data.gtmOnFailure();
});


